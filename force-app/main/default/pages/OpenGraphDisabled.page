<apex:page
  showHeader="false"
  sidebar="false"
  applyBodyTag="false"
  applyHtmlTag="false"
  docType="html-5.0"
  standardStylesheets="false"
  title="Open Graph Test - Disabled"
>
  <html>
    <head>
      <meta charset="UTF-8" />

      <!-- Deliberately no og:* meta tags here - this is the control page. -->

      <title>Open Graph Test - Disabled</title>

      <style>
        body {
          background-color: #f3f2f2;
          font-family:
            -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif;
          margin: 0;
          padding: 2rem;
        }
        .og-container {
          max-width: 640px;
          margin: 0 auto;
        }
        .og-badge {
          display: inline-block;
          background-color: #ba0517;
          color: #fff;
          font-size: 0.75rem;
          font-weight: 700;
          text-transform: uppercase;
          letter-spacing: 0.05em;
          padding: 0.25rem 0.6rem;
          border-radius: 0.25rem;
          margin-bottom: 0.75rem;
        }
      </style>
    </head>
    <body>
      <div class="og-container">
        <span class="og-badge">og tags: disabled</span>
        <h1>Open Graph Test Page - Disabled</h1>
        <p>
          This page has no <code>og:*</code> meta tags. It exists as a control
          so link-preview tools (Facebook Sharing Debugger, LinkedIn Post
          Inspector, Slack unfurl, etc) can be compared side by side against
          <a href="./OpenGraphEnabled">OpenGraphEnabled</a>. Without Open Graph
          tags, most tools fall back to the page's
          <code>&lt;title&gt;</code> and a generic or blank preview.
        </p>
      </div>
    </body>
  </html>
</apex:page>
