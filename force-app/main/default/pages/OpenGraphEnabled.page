<apex:page
  showHeader="false"
  sidebar="false"
  applyBodyTag="false"
  applyHtmlTag="false"
  docType="html-5.0"
  standardStylesheets="false"
  title="Open Graph Test - Enabled"
>
  <html>
    <head>
      <meta charset="UTF-8" />

      <!--
        TODO: replace the two URLs below with fully-qualified, publicly
        reachable URLs once this page is deployed and (if needed) exposed
        via a Salesforce Site / Experience Cloud site with Guest User
        access - OG scrapers do not authenticate, so this page and its
        og:image must be reachable without login.
      -->
      <meta property="og:type" content="website" />
      <meta property="og:site_name" content="DemoOrg" />
      <meta property="og:title" content="Open Graph Test Page - Enabled" />
      <meta
        property="og:description"
        content="This Visualforce page has Open Graph meta tags configured, used to verify link preview rendering (Facebook Sharing Debugger, LinkedIn Post Inspector, Slack unfurl, etc)."
      />
      <meta
        property="og:url"
        content="https://your-domain.my.site.com/OpenGraphEnabled"
      />
      <meta
        property="og:image"
        content="https://your-domain.my.site.com/resource/OpenGraphTestImage.png"
      />

      <title>Open Graph Test - Enabled</title>

      <style>
        body {
          background-color: #f3f2f2;
          font-family:
            -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif;
          margin: 0;
          padding: 2rem;
        }
        .og-container {
          max-width: 640px;
          margin: 0 auto;
        }
        .og-badge {
          display: inline-block;
          background-color: #04844b;
          color: #fff;
          font-size: 0.75rem;
          font-weight: 700;
          text-transform: uppercase;
          letter-spacing: 0.05em;
          padding: 0.25rem 0.6rem;
          border-radius: 0.25rem;
          margin-bottom: 0.75rem;
        }
        table {
          width: 100%;
          border-collapse: collapse;
          margin-top: 1rem;
          background: #fff;
        }
        th,
        td {
          text-align: left;
          padding: 0.5rem 0.75rem;
          border-bottom: 1px solid #e5e5e5;
          font-size: 0.875rem;
          word-break: break-word;
        }
        th {
          width: 140px;
          color: #555;
          font-weight: 600;
        }
      </style>
    </head>
    <body>
      <div class="og-container">
        <span class="og-badge">og tags: enabled</span>
        <h1>Open Graph Test Page - Enabled</h1>
        <p>
          This page publishes <code>og:title</code>,
          <code>og:description</code>, <code>og:image</code>,
          <code>og:url</code>, <code>og:type</code> and
          <code>og:site_name</code> meta tags. Paste this page's public URL into
          a link-preview debugger to confirm the card renders.
        </p>
        <table>
          <tr>
            <th>og:title</th>
            <td>Open Graph Test Page - Enabled</td>
          </tr>
          <tr>
            <th>og:description</th>
            <td>
              This Visualforce page has Open Graph meta tags configured...
            </td>
          </tr>
          <tr>
            <th>og:type</th>
            <td>website</td>
          </tr>
          <tr>
            <th>og:site_name</th>
            <td>DemoOrg</td>
          </tr>
          <tr>
            <th>og:url</th>
            <td>https://your-domain.my.site.com/OpenGraphEnabled</td>
          </tr>
          <tr>
            <th>og:image</th>
            <td>
              https://your-domain.my.site.com/resource/OpenGraphTestImage.png
            </td>
          </tr>
        </table>
      </div>
    </body>
  </html>
</apex:page>
