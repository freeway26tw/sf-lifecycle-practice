<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Generate_Lead_Summary</name>
        <label>Generate Lead Summary</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>Lead_Summary_ZH</actionName>
        <actionType>generatePromptResponse</actionType>
        <connector>
            <targetReference>Send_Summary_Email</targetReference>
        </connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>Input:ContactInfo</name>
            <value>
                <elementReference>Contact_Info_Text</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>Input:SourceInfo</name>
            <value>
                <elementReference>Source_Info_Text</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>Input:Rating</name>
            <value>
                <elementReference>$Record.Rating</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>Input:LeadScore</name>
            <value>
                <elementReference>Lead_Score_Text</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>Input:Description</name>
            <value>
                <elementReference>Description_Text</elementReference>
            </value>
        </inputParameters>
        <nameSegment>Lead_Summary_ZH</nameSegment>
        <offset>0</offset>
        <outputParameters>
            <assignToReference>Lead_Summary_Text</assignToReference>
            <name>promptResponse</name>
        </outputParameters>
    </actionCalls>
    <actionCalls>
        <name>Send_Summary_Email</name>
        <label>Send Summary Email</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>emailSimple</actionName>
        <actionType>emailSimple</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>recipientAddresses</name>
            <value>
                <collectionElements>
                    <elementReference>$Record.Owner:User.Email</elementReference>
                </collectionElements>
            </value>
        </inputParameters>
        <inputParameters>
            <name>senderType</name>
            <value>
                <stringValue>CurrentUser</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>composeEmailContent</name>
            <value>
                <stringValue>True</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailSubject</name>
            <value>
                <elementReference>Email_Subject_Text</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailBody</name>
            <value>
                <elementReference>Lead_Summary_Text</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>useLineBreaks</name>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>recipientId</name>
            <value>
                <elementReference>$Record.OwnerId</elementReference>
            </value>
        </inputParameters>
        <nameSegment>emailSimple</nameSegment>
        <offset>0</offset>
        <versionString>2.0.1</versionString>
    </actionCalls>
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <environments>Default</environments>
    <formulas>
        <name>Contact_Info_Text</name>
        <dataType>String</dataType>
        <expression>&quot;姓名：&quot; &amp; {!$Record.LastName} &amp; &quot; ／ 公司：&quot; &amp; {!$Record.Company} &amp; &quot; ／ Email：&quot; &amp; {!$Record.Email} &amp; &quot; ／ 電話：&quot; &amp; {!$Record.Phone}</expression>
    </formulas>
    <formulas>
        <name>Description_Text</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!$Record.Description}), &quot;（未填寫諮詢內容）&quot;, {!$Record.Description})</expression>
    </formulas>
    <formulas>
        <name>Email_Subject_Text</name>
        <dataType>String</dataType>
        <expression>&quot;【新潛在客戶摘要】&quot; &amp; {!$Record.LastName} &amp; &quot;（&quot; &amp; TEXT({!$Record.Rating}) &amp; &quot;）&quot;</expression>
    </formulas>
    <formulas>
        <name>Lead_Score_Text</name>
        <dataType>String</dataType>
        <expression>TEXT({!$Record.Lead_Score__c})</expression>
    </formulas>
    <formulas>
        <name>Source_Info_Text</name>
        <dataType>String</dataType>
        <expression>&quot;網站：&quot; &amp; IF(ISBLANK({!$Record.Website}), &quot;未提供&quot;, {!$Record.Website}) &amp; &quot; ／ 國家代碼：&quot; &amp; IF(ISBLANK(TEXT({!$Record.CountryCode})), &quot;未提供&quot;, TEXT({!$Record.CountryCode})) &amp; &quot; ／ 來源管道：&quot; &amp; IF(ISBLANK(TEXT({!$Record.LeadSource})), &quot;未提供&quot;, TEXT({!$Record.LeadSource}))</expression>
    </formulas>
    <interviewLabel>Lead Summary Email {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Lead Summary Email</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Generate_Lead_Summary</targetReference>
        </connector>
        <object>Lead</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>Lead_Summary_Text</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
